# V3 — additive, isolated. Must point at the SAME MongoDB and SAME JWT secret as v2.
# Never redefine JWT_SECRET here with a different value — v2-issued tokens must remain valid in v3.
# Do NOT create a real v3/server/.env with production credentials as part of this build —
# copy values from the existing v2/server/.env by hand/deploy-script instead.
NODE_ENV=production
PORT=4002
MONGO_URI=mongodb://127.0.0.1:27017/mep_projects
JWT_SECRET=change-this-to-match-v2-exactly
JWT_EXPIRES=30d
CORS_ORIGIN=*

# v3-only flag — per-company overrides live on Company.settings; this is a process-wide dev default only.
ENFORCE_ENTITLEMENTS_DEFAULT=false
