# New application backend — environment configuration
# This backend is completely independent of v2/v3 and must never point at their databases.

# MongoDB connection string for the NEW application's own database only.
# Example (local dev): mongodb://127.0.0.1:27017/mep_new_app
# Example (Atlas): mongodb+srv://<user>:<password>@<cluster>/mep_new_app
MONGODB_URI=

# Optional: override the default database name embedded in MONGODB_URI.
MONGODB_DB_NAME=mep_new_app

# --- Authentication (NEW BACKEND DESIGN — the PWA has no server/auth of its own) ---

# Secret used to sign/verify this application's own session tokens (JWT).
# Placeholder only — generate a long random value per environment, never reuse
# a V2/V3 secret, and never commit a real value.
AUTH_TOKEN_SECRET=replace-with-a-long-random-per-environment-secret

# How long an issued access token/session stays valid (jsonwebtoken "expiresIn" format).
AUTH_TOKEN_EXPIRY=15m

# Port the new backend's HTTP server listens on.
PORT=4000

# --- Notifications to the customer app (owner decision, 31 Oct 2026) ---
#
# The customer app is the portal added to a client's home screen. It can tell
# a client when an engineer is assigned, when a visit is arranged and when
# their service report is ready. That is Web Push, which needs one VAPID key
# pair per environment.
#
# Generate a pair once, on the server:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
# Put the public key in WEB_PUSH_PUBLIC_KEY and the private one in
# WEB_PUSH_PRIVATE_KEY. Never commit the private key, and never reuse the
# pair from another environment: changing it invalidates every subscription
# a client has already made, and they would have to switch notifications on
# again.
#
# Leave both empty and the feature is simply off: the app hides the switch
# and nothing is stored or sent. That is a supported state, not a fault.
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=

# Shown to the push service as the contact for this application, as a
# mailto: or https: URL. Required by the Web Push standard.
WEB_PUSH_SUBJECT=mailto:powertechsolution36@gmail.com
