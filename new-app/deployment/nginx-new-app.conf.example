# ── MEP New App — Nginx Server Block ──
#
# This is a SEPARATE Nginx server block for the new app.
# DO NOT modify existing Nginx configurations for other sites
# (ems-backend, glampower, spereon.codes).
#
# Domain: mep-projects.spereon.codes (previously used by old V2, now available)
#
# Installation:
#   1. Replace NEW_APP_DOMAIN with mep-projects.spereon.codes below
#      (or let the deploy script do it automatically)
#   2. Copy to /etc/nginx/sites-available/mep-new-app
#   3. sudo ln -s /etc/nginx/sites-available/mep-new-app /etc/nginx/sites-enabled/
#   4. sudo nginx -t
#   5. sudo systemctl reload nginx
#   6. After DNS points correctly: sudo certbot --nginx -d mep-projects.spereon.codes
#      (an existing SSL cert from old V2 may be reused automatically)
#
# Same-origin architecture: frontend + API on one domain.
# No separate API subdomain required.

# HTTP → HTTPS redirect (added by certbot after certificate issuance)
server {
    listen 80;
    listen [::]:80;
    server_name NEW_APP_DOMAIN;

    # Certbot will modify this block to redirect to HTTPS.
    # Until HTTPS is configured, serve normally for initial verification.
    root /var/www/mep-new-app/frontend/dist;
    index index.html;

    # API proxy → Node.js backend (PM2)
    location /api/ {
        proxy_pass http://127.0.0.1:4000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 30s;
        proxy_read_timeout 60s;
        proxy_send_timeout 60s;
        proxy_buffering off;
        client_max_body_size 10m;
    }

    # SPA fallback — all non-API, non-file routes → index.html
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Cache static assets (Vite hashed filenames)
    location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot)$ {
        expires 30d;
        add_header Cache-Control "public, immutable";
    }

    # Gzip
    gzip on;
    gzip_types text/plain text/css application/json application/javascript text/xml;
    gzip_min_length 256;
}
