# ── MEP New App — Production Environment ──
# Copy this file to /var/www/mep-new-app/backend/.env
# and fill in the actual production values.

# MongoDB connection string for the NEW APP's own database.
# Do NOT point at the V2/V3 database.
# Example (local): mongodb://127.0.0.1:27017/mep_new_app
# Example (Atlas): mongodb+srv://<user>:<password>@<cluster>/mep_new_app
MONGODB_URI=mongodb://127.0.0.1:27017/mep_new_app

# Optional: override the database name embedded in MONGODB_URI.
MONGODB_DB_NAME=mep_new_app

# Secret used to sign/verify JWT tokens.
# Generate a long random value: openssl rand -hex 48
# NEVER reuse a V2/V3 secret. NEVER commit this value.
AUTH_TOKEN_SECRET=

# How long an issued access token stays valid (jsonwebtoken "expiresIn" format).
AUTH_TOKEN_EXPIRY=15m

# Port the backend HTTP server listens on.
# V2 used 4001 (now removed). Port 4000 is free.
PORT=4000
