# Base URL of the dev backend (new-app/backend/src/devServer.js).
VITE_API_BASE_URL=http://localhost:4000

# Mobile-app downloads on the login page. Leave empty until the package is
# built, signed, installed and tested. Only https:// URLs are shown.
# VITE_ANDROID_APK_URL=https://<your-domain>/downloads/mep-projects.apk
# VITE_IOS_APP_URL=https://apps.apple.com/app/<app-id>
VITE_ANDROID_APK_URL=
VITE_IOS_APP_URL=
